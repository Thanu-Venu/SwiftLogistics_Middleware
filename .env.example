# Copy this file to .env and fill in real values before deploying anywhere
# other than your own laptop. docker-compose.yml reads these automatically.
#
# Local dev: you can leave this file absent entirely — every var below has a
# dev-safe default baked into docker-compose.yml.
#
# Public deploy: every value below MUST be changed to something random and
# unique. Generate secrets with: openssl rand -hex 32

POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_before_going_public
POSTGRES_DB=logistics

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change_me_before_going_public

# JWT signing key for the API gateway. Must be long and random in production.
SECRET_KEY=change_me_to_a_long_random_string

# Origin(s) allowed to call the API with credentials (CORS), as a regex.
# Local default (baked in): ^http://(localhost|127\.0\.0\.1):5173$
# Example prod value:
# CORS_ORIGIN_REGEX=^https://swiftlogistics\.duckdns\.org$

# Base URL the frontend is built against (baked in at build time by Vite).
# Local default (baked in): http://localhost:8000
# Example prod value:
# VITE_API_BASE=https://swiftlogistics-api.duckdns.org
